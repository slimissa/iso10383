{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_release.schema.json",
  "title": "registry_release.json",
  "description": "Self-description of one registry release, generated by tools/gen_registry_release.py. commit and tag_object are null in the committed file by design: the file ships inside the release commit and cannot contain that commit's SHA; the authoritative values are in docs/v<version>-verification.md and in the git tag.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry", "version", "schema_version", "released", "commit", "tag", "tag_object", "distribution", "source", "files", "counts", "vendors"],
  "properties": {
    "registry": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "released": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "tag_object": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "distribution": {"enum": ["source-only", "published"], "const": "source-only"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "snapshot", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "snapshot": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "layer", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "layer": {"enum": [1, 2, 3]},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operating", "segment", "active", "updated", "expired", "total", "countries", "market_categories", "segments_under_segment", "broken_chains", "tests", "claims"],
      "properties": {
        "operating": {"type": "integer", "minimum": 0},
        "segment": {"type": "integer", "minimum": 0},
        "active": {"type": "integer", "minimum": 0},
        "updated": {"type": "integer", "minimum": 0},
        "expired": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "countries": {"type": "integer", "minimum": 0},
        "market_categories": {"type": "integer", "minimum": 0},
        "segments_under_segment": {"type": "integer", "minimum": 0},
        "broken_chains": {"type": "integer", "minimum": 0},
        "tests": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["root", "python", "javascript", "rust", "go", "total"],
          "properties": {
            "root": {"type": "integer", "minimum": 0},
            "python": {"type": "integer", "minimum": 0},
            "javascript": {"type": "integer", "minimum": 0},
            "rust": {"type": "integer", "minimum": 0},
            "go": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 0}
          }
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": ["doc_facts", "in_file", "verified"],
          "properties": {
            "doc_facts": {"type": "integer", "minimum": 0},
            "in_file": {"type": "integer", "minimum": 0},
            "verified": {"type": ["integer", "null"], "minimum": 0}
          }
        }
      }
    },
    "vendors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source_version", "vendored_at", "file", "sha256", "review_by"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "source_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "vendored_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "file": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "review_by": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
        }
      }
    }
  }
}
